<!--os: windows osx linux-->

<joysticks>
    <joystick name="Xbox 360 Controller">

        <!--left stick-->
        <axis0 control="roll" dead="0.1"/>
        <axis1 control="pitch" dead="0.1"/>
        <axis1 control="menu_up_down" dead="0.5"/>

        <!--right stick-->
        <axis2 control="camera_yaw" invert="true" dead="0.1"/>
        <axis3 control="camera_pitch" invert="true" dead="0.1"/>
        <btn19 control="change_camera"/>

        <!--start-->
		<btn6 control="back"/>
        <btn7 control="pause"/>

        <!--triggers-->
        <btn4 control="brake"/>
        <btn5 control="throttle"/>
		<axis4 control="-yaw" dead="0.1"/>
		<axis5 control="+yaw" dead="0.1"/>

        <!--dpad-->
        <btn10 control="menu_up"/>
        <btn11 control="menu_next"/>
        <btn12 control="menu_down"/>
        <btn13 control="menu_prev"/>

        <!--buttons-->
		<btn2 control="change_weapon"/>
        <btn3 control="change_target"/>
        <btn1 control="missile"/>
        <btn0 control="mgun"/>
        <btn1 control="menu_next"/>
        <btn0 control="menu_prev"/>
    </joystick>

    <joystick name="Xbox Wireless Controller">
        <!--axis/button indices below refer to GLFW's STANDARDIZED gamepad layout
            (glfwGetGamepadState): [LX,LY,RX,RY,LT(0..1),RT(0..1)], A=0,B=1,X=2,Y=3,
            LB=4,RB=5,View=6,Start=7,Guide=8,LS=9,RS=10,dpad=11..14.
            The raw macOS layout of this controller is different (right stick on raw
            axes 3/4, triggers on 2/5 resting at -1, LS/RS on buttons 8/9, guide on
            10); demo.cpp injects a per-GUID gamepad mapping that rewrites it.-->

        <!--left stick-->
        <axis0 control="roll" dead="0.1"/>
        <axis1 control="pitch" dead="0.1"/>
        <axis1 control="menu_up_down" dead="0.5"/>

        <!--right stick (free look, full deflection = 90 degrees)-->
        <axis2 control="camera_yaw" invert="true" dead="0.1"/>
        <axis3 control="camera_pitch" dead="0.1"/>
        <btn10 control="change_camera"/>

        <!--dpad-->
        <btn11 control="menu_up"/>
        <btn12 control="menu_next"/>
        <btn13 control="menu_down"/>
        <btn14 control="menu_prev"/>

        <!--menu key-->
        <btn7 control="pause"/>

        <!--triggers: LT=brake, RT=throttle (0..1 in the standardized layout)-->
        <axis4 control="brake" dead="0.5"/>
        <axis5 control="throttle" dead="0.5"/>

        <!--shoulders: yaw left/right-->
        <btn4 control="-yaw"/>
        <btn5 control="+yaw"/>

        <!--buttons: A=mgun, B=missile, X=change_weapon, Y=change_target, View=flares-->
        <btn2 control="change_weapon"/>
        <btn3 control="change_target"/>
        <btn1 control="missile"/>
        <btn0 control="mgun"/>
        <btn6 control="flares"/>
        <btn1 control="menu_next"/>
        <btn0 control="menu_prev"/>
    </joystick>

    <joystick name="PLAYSTATION(R)3 Controller"> <!--part of the name, ignoring case-->

        <!--left stick-->
        <axis0 control="roll" dead="0.1"/>
        <axis1 control="pitch" dead="0.1"/>
        <axis1 control="pitch" invert="true" os="linux" dead="0.1"/>
        <axis1 control="menu_up_down" os="osx" dead="0.5"/>
        <axis1 control="menu_up_down" os="linux" invert="true" dead="0.5"/>
        <btn1/>

        <!--right stick-->
        <axis2 control="camera_yaw" invert="true" dead="0.1"/>
        <axis3 control="camera_pitch" dead="0.1"/>
        <btn2 control="change_camera"/>

        <!--select-->
        <btn0 control="change_weapon"/>

        <!--start-->
        <btn3 control="pause"/>

        <!--dpad-->
        <btn3 control="menu_prev"/>
        <btn4 control="menu_up"/>
        <btn5 control="menu_next"/>
        <btn6 control="menu_down"/>

        <!--triggers-->
        <btn8 control="-yaw"/>
        <btn9 control="+yaw"/>
        <btn10 control="brake"/>
        <btn11 control="throttle"/>

        <!--buttons-->
        <btn12 control="change_target"/>
        <btn13 control="missile"/>
        <btn14 control="mgun"/>
        <btn13 control="menu_next"/>
        <btn14 control="menu_prev"/>

    </joystick>

    <joystick name="Logitech Extreme 3D">
        <axis0 control="roll" dead="0.01"/>
        <axis1 control="pitch" dead="0.01"/>
        <axis1 control="pitch" os="linux" invert="true" dead="0.01"/>
        <axis2 control="yaw" dead="0.01"/>
        <axis3 control="throttle" os="osx" dead="0.01"/>
        <axis3 control="throttle" os="linux" invert="true" dead="0.01"/>
        <btn0 control="mgun"/>
        <btn1 control="missile"/>
        <btn2 control="missile"/>
        <btn4 control="change_target"/>
        <btn5 control="change_weapon"/>
        <btn6 control="brake"/>
        <btn7 control="brake"/>
        <btn8 control="change_camera"/>
        <btn9 control="change_camera"/>
        <btn10 control="pause"/>
        <btn11 control="pause"/>

        <axis1 control="menu_up_down" os="osx" dead="0.5"/>
        <axis1 control="menu_up_down" os="linux" invert="true" dead="0.5"/>
        <btn12 control="menu_up"/>
        <btn14 control="menu_down"/>
        <btn15 control="menu_prev"/>
        <btn13 control="menu_next"/>
        <btn0 control="menu_next"/>
        <btn1 control="menu_prev"/>
    </joystick>
	
    <joystick name="Microsoft PC-joystick driver">
        <axis0 control="roll" dead="0.01"/>
        <axis1 control="pitch" invert="true" dead="0.01"/>
		<axis2 control="yaw" invert="true" dead="0.05"/>

        <btn0 control="mgun"/>
        <btn1 control="missile"/>
        <btn2 control="change_weapon"/>
        <btn3 control="change_target"/>
        <btn4 control="brake"/>
        <btn5 control="throttle"/>
        <btn6 control="radar"/>
        <btn7 control="pause"/>
        <btn8 control="flare"/>
        <btn9 control="change_camera"/>

        <axis1 control="menu_up_down" invert="true" dead="0.5"/>
		<btn10 control="menu_up"/>
		<btn12 control="menu_down"/>
        <btn11 control="menu_next"/>
		<btn13 control="menu_prev"/>
		<btn0 control="menu_next"/>
		<btn1 control="menu_prev"/>
    </joystick>
</joysticks>
